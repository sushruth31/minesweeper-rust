# Board configuration.
#
# These are BUILD-time variables: a wasm module has no process environment, so
# they are read with option_env! while cargo compiles and baked into the binary.
# Export them (or `set -a; . ./.env; set +a`) before running trunk:
#
#   MINESWEEPER_WIDTH=16 MINESWEEPER_HEIGHT=16 MINESWEEPER_MINES=40 trunk serve
#
# Changing a value requires a rebuild, not just a page reload.
# Any value that is unset falls back to the default shown here. Any value that
# is not a non-negative integer aborts start-up with an on-page error naming
# the variable.

# Columns in the grid. Minimum 1.
MINESWEEPER_WIDTH=10

# Rows in the grid. Minimum 1.
MINESWEEPER_HEIGHT=10

# Mines to place. Must be <= (WIDTH * HEIGHT) - 9, because the opening click
# and its eight neighbours are always kept mine-free.
MINESWEEPER_MINES=15
